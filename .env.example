# ---- LLM -------------------------------------------------------------------
# live | mock | auto   (auto = live, а при отсутствии ключа/падении сети -> mock)
LLM_MODE=auto
OPENAI_API_KEY=
# Переопределяется для NVIDIA NIM / OpenRouter / любого OpenAI-совместимого шлюза
OPENAI_BASE_URL=
LLM_MODEL=gpt-4.1-mini
LLM_FALLBACK_MODEL=gpt-4.1-nano

# ---- DB --------------------------------------------------------------------
# Локально: file:./.data/hack.db
# Vercel:   libsql://<db>-<org>.turso.io  + DB_AUTH_TOKEN
DB_URL=file:./.data/hack.db
DB_AUTH_TOKEN=

# ---- API каталога партнёра (ekt.kz) ---------------------------------------
# Реальные значения лежат в .env.local и в репозиторий не попадают.
EKT_API_BASE=https://ekt.kz/api
EKT_API_USER=
EKT_API_PASSWORD=
